#!/usr/bin/env bash
set -euo pipefail

ATOMIC_DIR="atomic"
BEHAVIOURS_DIR="behaviours"

# Follow symlinks (e.g. from `npm link`) to the real script, so lib/ is found
# next to it. Bash 3.2 / BSD has no `readlink -f`, so resolve one link at a
# time, treating a relative target as relative to the link's directory.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  LINK_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" == /* ]] || SOURCE="$LINK_DIR/$SOURCE"
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"

source "$SCRIPT_DIR/lib/helpers.sh"
source "$SCRIPT_DIR/lib/atomic-init"
source "$SCRIPT_DIR/lib/atomic-status"
source "$SCRIPT_DIR/lib/atomic-progress"
source "$SCRIPT_DIR/lib/atomic-show-spec"
source "$SCRIPT_DIR/lib/atomic-show-stack"
source "$SCRIPT_DIR/lib/atomic-commit"
source "$SCRIPT_DIR/lib/atomic-push"
source "$SCRIPT_DIR/lib/atomic-clean"
source "$SCRIPT_DIR/lib/atomic-rollback"
source "$SCRIPT_DIR/lib/atomic-start-over"
source "$SCRIPT_DIR/lib/atomic-stack-add"
source "$SCRIPT_DIR/lib/atomic-help"

# ── dispatch ──────────────────────────────────────────────────────────────────

JSON_OUTPUT="false"
CMD=""
ARGS=()

for arg in "$@"; do
  case "$arg" in
    --json) JSON_OUTPUT="true" ;;
    -*) ;;
    *) if [[ -z "$CMD" ]]; then CMD="$arg"; else ARGS+=("$arg"); fi ;;
  esac
done

case "$CMD" in
  init)            cmd_init ;;
  status)          cmd_status ;;
  progress)        cmd_progress ;;
  show-spec)       cmd_show_spec ;;
  show-stack)      cmd_show_stack ;;
  commit)          cmd_commit ;;
  push)            cmd_push ;;
  clean)           cmd_clean ;;
  rollback)        cmd_rollback ;;
  start-over)      cmd_start_over ;;
  stack-add)       cmd_stack_add "${ARGS[0]:-}" ;;
  ""|help|--help)  cmd_help ;;
  *)               echo "{\"error\":\"unknown command: $CMD\"}" >&2; exit 1 ;;
esac
