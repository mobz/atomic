cmd_commit() {
  require_git

  [[ -f "$ATOMIC_DIR/spec.md" ]] || die "no spec found — run /at:spec first, or atomic stack-add for planning"

  local unchecked
  unchecked=$(grep -c '^- \[ \]' "$ATOMIC_DIR/spec.md" 2>/dev/null || true)
  unchecked=${unchecked:-0}
  if [[ $unchecked -gt 0 ]]; then
    die "$unchecked change(s) not yet complete — mark all items [X] in spec.md first"
  fi

  local intent
  intent=$(grep -m1 '^\*\*Intent:\*\*' "$ATOMIC_DIR/spec.md" 2>/dev/null | sed 's/\*\*Intent:\*\* //' || true)
  [[ -n "$intent" ]] || die "spec has no Intent line — add one to atomic/spec.md"

  # Stage everything except the spec; remove it only once the commit has
  # succeeded, so a failed commit leaves the pipeline in state ready.
  git add -A
  git rm --cached -q --ignore-unmatch -- "$ATOMIC_DIR/spec.md"
  git commit -m "$intent" || die "commit failed — atomic/spec.md kept; fix the cause and run atomic commit again"

  rm -f "$ATOMIC_DIR/spec.md"

  if [[ "$JSON_OUTPUT" == "true" ]]; then
    local sha
    sha=$(git rev-parse HEAD)
    printf '{"ok":true,"sha":"%s","message":"%s"}\n' "$sha" "${intent//\"/\\\"}"
  else
    echo "Committed: $intent"
    git log -1 --oneline
  fi
}
